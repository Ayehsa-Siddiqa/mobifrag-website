# Contact form email (Gmail SMTP).
# SMTP_PASS must be a Google "App Password" (16 chars), not the normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mobifragofficial@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# Where enquiries are delivered (defaults to site email in src/lib/content.ts)
CONTACT_TO=mobifragofficial@gmail.com
